# Base URL of the API Gateway (must include /api). Never point production at localhost.
VITE_API_BASE_URL=http://localhost:8080/api

# development | production. Defaults to Vite's own build mode when unset.
VITE_APP_ENV=development

# Not secrets: every VITE_* value ships inside the built JS bundle and is readable by anyone who
# opens DevTools on the deployed site. MSAL public-client IDs are meant to be public — OAuth safety
# comes from the redirect URI registered with Entra, not from hiding these. Safe to share in chat or
# fill in directly here for the team; only real secrets (JWT keys, CSRF_SIGNING_SECRET, DB
# passwords, deploy keys) stay backend-only, in GitHub Actions Secrets / the ops password manager.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
VITE_MICROSOFT_REDIRECT_URI=http://localhost:5173
