# Invariants of a production build, in one place.
#
# CI, docker-compose and a developer checking the bundle by hand used to each spell
# these out separately. Vite loads this file for every production-mode build, so the
# build paths cannot drift.
#
# Only values that are the same in every environment belong here. Anything that
# varies -- VITE_API_BASE_URL, the Microsoft client/tenant/redirect -- stays a build
# argument. Never put a secret in this file: it is committed and it ends up in the
# bundle.
VITE_APP_ENV=production
