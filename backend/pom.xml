<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>vn.edu.tvu</groupId>
    <artifactId>tvu-event-ticket-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TVU Event &amp; Ticket - Backend</name>
    <description>Modular monolith event management and e-ticketing platform</description>

    <!-- Spring Boot as parent so all modules inherit dependency management -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <modules>
        <module>monolith</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!-- Not managed by the Spring Boot BOM. It used to come from the Spring Cloud release
             train, which was imported solely for this one version once the gateway was deleted.
             Nothing imports spring-retry directly; Spring AMQP needs it on the classpath for
             spring.rabbitmq.listener.simple.retry.* to work. -->
        <spring-retry.version>2.0.13</spring-retry.version>
        <flyway.version>12.10.0</flyway.version>
        <springdoc.version>3.0.3</springdoc.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <postgresql.version>42.7.13</postgresql.version>
        <tomcat.version>11.0.24</tomcat.version>
        <!-- Ahead of the Spring Boot 4.0.7 BOM (4.2.15.Final), which dependency-check rejects for
             CVE-2026-44891, CVE-2026-55831 and CVE-2026-55833 (all fixed in 4.2.16.Final). Netty
             arrives transitively through Lettuce; drop this once the BOM catches up. -->
        <netty.version>4.2.16.Final</netty.version>
        <!-- Ahead of the Spring Boot 4.0.7 BOM (2.25.4), which dependency-check flags for
             CVE-2026-49844, fixed in 2.25.5. This one property covers both modules that arrive
             through spring-boot-starter-logging — log4j-to-slf4j and the log4j-api underneath it —
             so they cannot drift apart. Drop it once the BOM catches up. -->
        <log4j2.version>2.25.5</log4j2.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Jackson 2, and only Jackson 2. Two Jackson lines are on this classpath: Spring Boot
                 4 uses tools.jackson 3.x for its own binding, while springdoc pulls
                 com.fasterxml.jackson 2.x through swagger-core. The 2.x line is the one
                 dependency-check flags — CVE-2026-54515 against jackson-databind 2.21.4, fixed in
                 2.21.5.

                 Imported as a BOM rather than pinned per artifact, so databind, core,
                 dataformat-yaml and datatype-jsr310 move together; pinning databind alone is how a
                 classpath ends up with two halves of the same library at different versions.

                 jackson-annotations stays at 2.21 and that is correct, not drift: since 2.20
                 upstream deliberately dropped the patch component from that one artifact, and the
                 2.21.5 BOM itself declares it as 2.21.

                 NOT done by overriding Spring Boot's jackson-bom.version property: that property
                 resolves to 3.1.4 and points at the Jackson 3 line, so raising it would move the
                 binding Spring Boot actually uses while leaving the vulnerable 2.x artifacts
                 exactly where they were. -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>2.21.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-build-toolchain</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion><version>[25,26)</version></requireJavaVersion>
                                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                    <execution>
                        <id>enforce-no-webjars</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <!--
                                    This application serves no static assets: the frontend is a
                                    separate Nginx container. A webjar on the classpath is therefore
                                    third-party JavaScript that nothing renders but everything ships
                                    — and Spring Boot maps /webjars/** onto it by default, so it is
                                    reachable as well as present.

                                    That is not hypothetical here. springdoc's ui starter packaged
                                    swagger-ui, which is where CVE-2026-65898 (DOMPurify) came from,
                                    and any signed-in user could fetch the page through /webjars/**.
                                    The application moved to springdoc's api starter to remove it.

                                    Banning the group, not just the one artifact, because the next
                                    webjar will arrive under a different name and most likely
                                    transitively, where nobody is looking. A legitimate future need
                                    then has to change this line, which makes the decision visible
                                    instead of silent.

                                    Complements rather than replaces the runtime layers:
                                    spring.web.resources.add-mappings=false, denyAll on /webjars/**,
                                    and ProductionDocumentationValidator. Those stop a webjar being
                                    served; this stops one arriving.
                                -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.webjars</exclude>
                                        <exclude>org.webjars.*</exclude>
                                        <exclude>org.springdoc:springdoc-openapi-starter-webmvc-ui</exclude>
                                    </excludes>
                                    <message>
No webjars, and not the springdoc ui starter that pulls one. This application
        renders no Swagger UI (/swagger-ui/index.html answers 401 in every profile), so a webjar
        here is unrendered third-party JavaScript that still ships and is still routable. If one is
        genuinely needed, remove the ban deliberately and say why in the commit.
                                    </message>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
