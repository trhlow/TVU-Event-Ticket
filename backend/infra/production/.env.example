# Public domain. DNS A/AAAA records must point here before starting Caddy.
APP_DOMAIN=events.example.com

# PostgreSQL. The owner account is reserved for migrations; the application
# uses a separate runtime account with row-level read/write privileges only.
# Generate each password independently with: openssl rand -base64 32
POSTGRES_DB=tvu_app
POSTGRES_USER=tvu_owner
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
POSTGRES_APP_USER=tvu_app
POSTGRES_APP_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET

# Application database pool. Keep this low on a single 4 GB VPS.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=5000

# Redis and RabbitMQ credentials. Never reuse passwords across services.
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
RABBITMQ_DEFAULT_USER=tvu_app
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Application identity and signing secrets.
JWT_ISSUER_URI=https://events.example.com
JWT_TTL=15m
JWT_KEY_ID=tvu-prod-2026
CSRF_SIGNING_SECRET=REPLACE_WITH_A_32_BYTE_OR_LONGER_SECRET
QR_SIGNING_SECRET=REPLACE_WITH_A_32_BYTE_OR_LONGER_SECRET
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# HMAC pepper for stored OTP digests. Startup fails if this is unset, left at the
# development value, or shorter than the minimum length. It must not reuse any other
# secret in this file; preflight.sh enforces that. Rotating it invalidates every code
# currently waiting to be used, which is by design — users request a new code.
OTP_PEPPER=REPLACE_WITH_A_32_BYTE_OR_LONGER_SECRET

# Use a one-line PEM value with literal \\n separators, or mount a secret manager later.
JWT_PRIVATE_KEY_PEM=REPLACE_WITH_PKCS8_PRIVATE_KEY
JWT_PUBLIC_KEY_PEM=REPLACE_WITH_X509_PUBLIC_KEY

# Microsoft Entra application registration used by the browser login. The registration must be
# single-tenant; MICROSOFT_TENANT_ID is enforced server-side so a token from any other directory is
# rejected even if that setting is later widened. Startup fails when it is unset.
# These two are not typed in by hand: generate-env.sh copies them from
# frontend/.env.production, which is tracked in Git and is what the frontend bundle was built
# from. The backend needs them at runtime -- it checks the aud claim against the client id and the
# tid claim against the tenant id -- while the frontend needs them baked into the bundle, so there
# are two representations of one fact. preflight.sh requires them to agree; when they do not, the
# symptom is a user who signs in with Microsoft successfully and is then rejected by the API.
MICROSOFT_CLIENT_ID=REPLACE_WITH_MICROSOFT_APPLICATION_CLIENT_ID
MICROSOFT_TENANT_ID=REPLACE_WITH_MICROSOFT_DIRECTORY_TENANT_ID
MICROSOFT_ISSUER_HOST=https://login.microsoftonline.com
MICROSOFT_JWKS_URI=https://login.microsoftonline.com/common/discovery/v2.0/keys

# Transactional email provider. For Resend SMTP use the credential issued in its dashboard.
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=REPLACE_WITH_SMTP_CREDENTIAL
MAIL_FROM_ADDRESS=no-reply@events.example.com
MAIL_FROM_NAME=TVU Events

# Local image tag. The deployment workflow builds this tag on the server.
MONOLITH_IMAGE=tvu-event-ticket-monolith:production
