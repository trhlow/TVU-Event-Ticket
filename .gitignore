# Universal OS/editor ignores shared by every subproject in this monorepo.
# Stack-specific ignores (Java/Maven, Node, etc.) belong in each subproject's own .gitignore
# (see backend/.gitignore) — nested .gitignore files apply within their own subtree.
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Git worktrees for isolated feature development
.worktrees/

# ---- AI coding-agent tooling (local only, never committed) ----
# Skills, agents, hooks, session logs and plan/spec scratch files belong to each
# developer's machine, not to the shared history. Keep them out of every branch so
# main stays product code only.
.claude/
AGENTS.md
CLAUDE.md
skills-lock.json
docs/superpowers/

# publish-decision.sh imports canonical.py, so running it leaves bytecode beside the scripts.
__pycache__/
*.pyc

# Collector test fixture images: rebuilt by the test suite from the tracked Dockerfile, never
# committed -- a multi-MB binary that would only grow the repo for no benefit over rebuilding it.
.github/scripts/collector-fixtures/*.tar
